<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Chorus.Core</RootNamespace>
    <AssemblyName>Chorus.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Concentus" Version="2.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Packaged wake-word model: MFCC templates + canonical PCM sample
         (generated by tests/wakeword_templates.py, loaded by WakeWordEngine). -->
    <EmbeddedResource Include="WakeWord\Resources\*.mfc" />
    <EmbeddedResource Include="WakeWord\Resources\*.pcm" />
  </ItemGroup>

</Project>
